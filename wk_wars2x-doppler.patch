 	Radar updating
 ------------------------------------------------------------------------------------*/
+
+/*------------------------------------------------------------------------------------
+	Doppler radar audio
+------------------------------------------------------------------------------------*/
+const dopplerAudio = {
+  context: null,
+  oscillator: null,
+  harmonic: null,
+  gain: null,
+  harmonicGain: null,
+  frequency: 360,
+  gainValue: 0,
+  targetFrequency: 360,
+  targetGain: 0,
+};
+
+function ensureDopplerAudio() {
+  if (dopplerAudio.context) {
+    if (dopplerAudio.context.state === "suspended") {
+      dopplerAudio.context.resume().catch(() => {});
+    }
+    return true;
+  }
+
+  const AudioContextClass = window.AudioContext || window.webkitAudioContext;
+  if (!AudioContextClass) return false;
+
+  dopplerAudio.context = new AudioContextClass();
+  dopplerAudio.oscillator = dopplerAudio.context.createOscillator();
+  dopplerAudio.harmonic = dopplerAudio.context.createOscillator();
+  dopplerAudio.gain = dopplerAudio.context.createGain();
+  dopplerAudio.harmonicGain = dopplerAudio.context.createGain();
+
+  dopplerAudio.oscillator.type = "sine";
+  dopplerAudio.harmonic.type = "triangle";
+  dopplerAudio.oscillator.frequency.value = dopplerAudio.frequency;
+  dopplerAudio.harmonic.frequency.value = dopplerAudio.frequency * 2.0;
+  dopplerAudio.gain.gain.value = 0.0;
+  dopplerAudio.harmonicGain.gain.value = 0.0;
+
+  dopplerAudio.oscillator.connect(dopplerAudio.gain);
+  dopplerAudio.harmonic.connect(dopplerAudio.harmonicGain);
+  dopplerAudio.gain.connect(dopplerAudio.context.destination);
+  dopplerAudio.harmonicGain.connect(dopplerAudio.context.destination);
+
+  dopplerAudio.oscillator.start();
+  dopplerAudio.harmonic.start();
+  return true;
+}
+
+function setDopplerAudio(active, speed, closing, volume) {
+  if (!ensureDopplerAudio()) return;
+
+  const targetSpeed = Math.max(0, Number(speed) || 0);
+  const maxSpeed = 180.0;
+
+  if (!active || targetSpeed <= 0.0) {
+    dopplerAudio.targetGain = 0.0;
+    return;
+  }
+
+  const normalized = Math.min(targetSpeed / maxSpeed, 1.0);
+
+  // Approaching targets sweep upward; receding targets sweep downward.
+  // The speed is radial speed, so patrol-car speed is already included.
+  if (closing) {
+    dopplerAudio.targetFrequency = 300.0 + normalized * 750.0;
+  } else {
+    dopplerAudio.targetFrequency = 1050.0 - normalized * 700.0;
+  }
+
+  dopplerAudio.targetFrequency = Math.max(180.0, Math.min(1050.0, dopplerAudio.targetFrequency));
+  dopplerAudio.targetGain = Math.max(0.0, Math.min(1.0, Number(volume) || 0.0)) * (0.28 + normalized * 0.72);
+}
+
+function updateDopplerAudio() {
+  if (!dopplerAudio.context || !dopplerAudio.oscillator) return;
+
+  dopplerAudio.frequency += (dopplerAudio.targetFrequency - dopplerAudio.frequency) * 0.18;
+  dopplerAudio.gainValue += (dopplerAudio.targetGain - dopplerAudio.gainValue) * 0.16;
+
+  const now = dopplerAudio.context.currentTime;
+  dopplerAudio.oscillator.frequency.setTargetAtTime(dopplerAudio.frequency, now, 0.035);
+  dopplerAudio.harmonic.frequency.setTargetAtTime(dopplerAudio.frequency * 2.01, now, 0.045);
+  dopplerAudio.gain.gain.setTargetAtTime(dopplerAudio.gainValue, now, 0.04);
+  dopplerAudio.harmonicGain.gain.setTargetAtTime(dopplerAudio.gainValue * 0.14, now, 0.05);
+}
+
+setInterval(updateDopplerAudio, 30);
