 -- This is the main function that runs and handles all information that is sent to the NUI side for display, all
 -- speed values are converted on the Lua side into a format that is displayable using the custom font on the NUI side
+local function getDopplerTarget(av)
+	if not config.doppler or not config.doppler.enabled or not PLY.veh then
+		return nil
+	end
+
+	local patrolCoords = GetEntityCoords(PLY.veh)
+	local patrolVelocity = GetEntityVelocity(PLY.veh)
+	local best = nil
+
+	for _, ant in ipairs({ "front", "rear" }) do
+		if RADAR:IsAntennaTransmitting(ant) and av[ant] ~= nil then
+			-- Prefer the strongest target, then consider the fastest target as a
+			-- fallback. Both are already filtered by the radar's ray traces.
+			for _, targetData in ipairs({ av[ant][1], av[ant][2] }) do
+				if targetData ~= nil and utils.isEntityValid(targetData.veh) then
+					local targetCoords = GetEntityCoords(targetData.veh)
+					local targetVelocity = GetEntityVelocity(targetData.veh)
+					local dx = targetCoords.x - patrolCoords.x
+					local dy = targetCoords.y - patrolCoords.y
+					local dz = targetCoords.z - patrolCoords.z
+					local distance = math.sqrt(dx * dx + dy * dy + dz * dz)
+
+					if distance > 0.01 then
+						-- Project relative velocity onto the line of sight. Negative
+						-- means the target is approaching; positive means receding.
+						local relX = targetVelocity.x - patrolVelocity.x
+						local relY = targetVelocity.y - patrolVelocity.y
+						local relZ = targetVelocity.z - patrolVelocity.z
+						local radialSpeed = (relX * dx + relY * dy + relZ * dz) / distance
+						local absoluteSpeed = math.abs(radialSpeed)
+
+						if absoluteSpeed >= (config.doppler.minSpeed or 1.0) then
+							local convertedSpeed = RADAR:GetVehSpeedConverted(absoluteSpeed)
+							if best == nil or absoluteSpeed > best.rawSpeed then
+								best = {
+									rawSpeed = absoluteSpeed,
+									speed = convertedSpeed,
+									closing = radialSpeed < 0.0,
+									ant = ant
+								}
+							end
+						end
+					end
+				end
+			end
+		end
+	end
+
+	return best
+end
